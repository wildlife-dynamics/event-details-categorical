{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Workflow Details"
    },
    "er_client": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "description": "Select one of your configured data sources.",
          "title": ""
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Data Source"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "description": "The start time",
          "format": "date-time",
          "title": "Since",
          "type": "string"
        },
        "until": {
          "description": "The end time",
          "format": "date-time",
          "title": "Until",
          "type": "string"
        },
        "timezone": {
          "$ref": "#/$defs/TimezoneInfo",
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period. Events created in this period are included.",
      "title": "Time Range"
    },
    "fields": {
      "additionalProperties": false,
      "properties": {
        "event_type": {
          "description": "Select the event type to analyze.",
          "title": "Event Type",
          "type": "string",
          "ecoscope:transform": [
            {
              "transformer": "EarthRangerEnumResolver",
              "transformer_kws": {
                "type": "event_type",
                "depends_on": "properties.er_client.properties.data_source.properties.name"
              }
            }
          ]
        },
        "main_field": {
          "description": "Select the choice field the workflow will summarize, e.g. Species. Each choice will be represented by a different color in the outputs. The list shows the selected event type's choice fields, including those in repeating groups, e.g. Detection: Species.",
          "title": "Categorical Field - Choice field to analyze",
          "type": "string",
          "ecoscope:transform": [
            {
              "transformer": "EarthRangerEnumResolver",
              "transformer_kws": {
                "type": "event_type_schema_choice_prop",
                "depends_on": "properties.fields.properties.event_type",
                "include_nested": true
              }
            }
          ]
        },
        "count_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/CountEvents"
            },
            {
              "$ref": "#/$defs/SumNumericField"
            }
          ],
          "default": {
            "count_by": "Events"
          },
          "description": "Events counts each event once, or each row for a field in a list, e.g. each detection for Detection: Species. Numeric Field adds up a number on the form, e.g. Count, to show animals counted rather than sightings.",
          "ecoscope:advanced": true,
          "title": "Count By"
        },
        "split_write_ins": {
          "default": false,
          "description": "Show each name typed for an \"Other\" answer as its own value, e.g. \"Other: Flappet Lark\", instead of one \"Other\". Names are kept as typed.",
          "ecoscope:advanced": true,
          "title": "Show Typed \"Other\" Names",
          "type": "boolean"
        },
        "keep_form_order": {
          "default": false,
          "description": "Show the values in the order they appear on the form instead of by count, e.g. for age class or water level.",
          "ecoscope:advanced": true,
          "title": "Keep Form Order",
          "type": "boolean"
        },
        "show_full_list": {
          "default": false,
          "description": "Show every value in the outputs instead of the 10 most common plus \"Other\".",
          "ecoscope:advanced": true,
          "title": "Show Every Value",
          "type": "boolean"
        }
      },
      "required": [
        "event_type",
        "main_field"
      ],
      "type": "object",
      "title": "Event Type and Fields"
    },
    "groupers": {
      "additionalProperties": false,
      "properties": {
        "groupers": {
          "default": null,
          "description": "Choose how to split the outputs into views, e.g. by year or reporter (optional). Leave empty for one view of all events.",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/TemporalGrouper"
              },
              {
                "$ref": "#/$defs/ValueGrouper"
              }
            ],
            "title": "Group by"
          },
          "title": " ",
          "type": "array"
        }
      },
      "type": "object",
      "required": [],
      "title": "Group by"
    },
    "base_maps": {
      "additionalProperties": false,
      "properties": {
        "base_maps": {
          "default": [
            {
              "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
              "opacity": 1,
              "max_zoom": 20,
              "min_zoom": 0
            },
            {
              "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
              "opacity": 0.5,
              "max_zoom": 20,
              "min_zoom": 0
            }
          ],
          "description": "Select tile layers to use as base layers in map outputs. The first layer in the list will be the bottommost layer displayed.",
          "ecoscope:advanced": true,
          "items": {
            "anyOf": [
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                    "enum": [
                      "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1,
                    "minimum": 0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Open Street Map",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1,
                    "minimum": 0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Roadmap",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1,
                    "minimum": 0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Satellite",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1,
                    "minimum": 0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Terrain",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1,
                    "minimum": 0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "USGS Hillshade",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://example.tiles.com/{z}/{x}/{y}.png",
                    "description": "The URL of a publicly accessible tiled raster service.",
                    "pattern": "https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}([-a-zA-Z0-9()@:%_\\+.~#?&//=\\{\\}]*)",
                    "title": "Custom Layer URL",
                    "type": "string"
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1,
                    "minimum": 0,
                    "title": "Custom Layer Opacity",
                    "type": "number"
                  },
                  "max_zoom": {
                    "default": 20,
                    "description": "Set the maximum zoom level to fetch tiles for.",
                    "title": "Custom Layer Max Zoom",
                    "type": "integer"
                  },
                  "min_zoom": {
                    "default": 0,
                    "description": "Set the minimum zoom level to fetch tiles for.",
                    "title": "Custom Layer Min Zoom",
                    "type": "integer"
                  }
                },
                "title": "Custom Layer (Advanced)",
                "type": "object"
              }
            ],
            "title": "Base Layer"
          },
          "title": " ",
          "type": "array"
        }
      },
      "type": "object",
      "required": [],
      "title": "Base Maps"
    },
    "Time Period": {
      "type": "object",
      "description": "The period each bar covers in the chart over time and the tiles' trend lines.",
      "ecoscope:task_group": true,
      "properties": {
        "trend_period": {
          "additionalProperties": false,
          "properties": {
            "period": {
              "default": "auto",
              "description": "Choose the time interval for the charts over time. Auto picks one based on the time range.",
              "ecoscope:advanced": true,
              "enum": [
                "auto",
                "week",
                "month",
                "quarter",
                "year"
              ],
              "title": "Time Period",
              "type": "string"
            }
          },
          "type": "object",
          "required": [],
          "title": ""
        }
      }
    },
    "Grid Map": {
      "type": "object",
      "description": "Where each value is concentrated, counted in grid squares.",
      "ecoscope:task_group": true,
      "properties": {
        "grid": {
          "additionalProperties": false,
          "properties": {
            "cell_size_km": {
              "default": null,
              "description": "Set the size of the grid squares in km (optional). Leave empty to fit the squares to the area of the events.",
              "ecoscope:advanced": true,
              "title": "Grid Square Size (km)",
              "type": "number"
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        }
      }
    }
  },
  "$defs": {
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    },
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "CountEvents": {
      "properties": {
        "count_by": {
          "const": "Events",
          "default": "Events",
          "ecoscope:advanced": true,
          "title": "Count By",
          "type": "string"
        }
      },
      "title": "Events",
      "type": "object"
    },
    "SumNumericField": {
      "properties": {
        "count_by": {
          "const": "Numeric Field",
          "default": "Numeric Field",
          "ecoscope:advanced": true,
          "title": "Count By",
          "type": "string"
        },
        "field": {
          "description": "The numeric field to add up for each value, e.g. Count.",
          "title": "Field",
          "type": "string",
          "ecoscope:transform": [
            {
              "transformer": "EarthRangerEnumResolver",
              "transformer_kws": {
                "type": "event_type_schema_numeric_prop",
                "depends_on": "properties.fields.properties.event_type",
                "include_nested": true
              }
            }
          ]
        }
      },
      "required": [
        "field"
      ],
      "title": "Numeric Field",
      "type": "object"
    },
    "SpatialGrouper": {
      "properties": {
        "spatial_index_name": {
          "title": "Spatial Regions",
          "type": "string"
        }
      },
      "required": [
        "spatial_index_name"
      ],
      "title": "Spatial",
      "type": "object"
    },
    "TemporalGrouper": {
      "properties": {
        "temporal_index": {
          "oneOf": [
            {
              "const": "%Y",
              "title": "Year (example: 2024)"
            },
            {
              "const": "%B",
              "title": "Month (example: September)"
            },
            {
              "const": "%Y-%m",
              "title": "Year and Month (example: 2023-01)"
            },
            {
              "const": "%j",
              "title": "Day of the year as a number (example: 365)"
            },
            {
              "const": "%d",
              "title": "Day of the month as a number (example: 31)"
            },
            {
              "const": "%A",
              "title": "Day of the week (example: Sunday)"
            },
            {
              "const": "%H",
              "title": "Hour (24-hour clock) as number (example: 22)"
            },
            {
              "const": "%Y-%m-%d",
              "title": "Date (example: 2025-01-31)"
            }
          ],
          "title": "Time",
          "type": "string"
        }
      },
      "required": [
        "temporal_index"
      ],
      "title": "Time",
      "type": "object"
    },
    "ValueGrouper": {
      "properties": {
        "index_name": {
          "title": "Category",
          "type": "string",
          "oneOf": [
            {
              "const": "reported_by_name",
              "title": "Reported By"
            }
          ]
        }
      },
      "required": [
        "index_name"
      ],
      "title": "Category",
      "type": "object"
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "time_range": {
      "ui:order": [
        "since",
        "until",
        "timezone"
      ]
    },
    "fields": {
      "ui:order": [
        "event_type",
        "main_field",
        "count_by",
        "split_write_ins",
        "keep_form_order",
        "show_full_list"
      ],
      "count_by": {
        "anyOf": [
          {
            "ui:options": {
              "label": false
            },
            "count_by": {
              "ui:widget": "hidden"
            }
          },
          {
            "ui:options": {
              "label": false
            },
            "count_by": {
              "ui:widget": "hidden"
            }
          }
        ],
        "count_by": {
          "ui:widget": "hidden"
        }
      }
    },
    "ui:order": [
      "workflow_details",
      "er_client",
      "time_range",
      "fields",
      "groupers",
      "base_maps",
      "Time Period",
      "Grid Map"
    ],
    "groupers": {
      "groupers": {
        "items": {
          "anyOf": [
            {
              "ui:options": {
                "label": false
              }
            },
            {
              "ui:options": {
                "label": false
              }
            }
          ]
        }
      }
    },
    "base_maps": {
      "base_maps": {
        "items": {
          "ui:options": {
            "label": false
          }
        }
      }
    }
  },
  "additionalProperties": false
}
